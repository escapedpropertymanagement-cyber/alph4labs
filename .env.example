# Alph4 Labs Ops dashboard — environment variables
# Copy to .env locally, or set these in Railway/Render's dashboard.

# HTTP basic auth — anyone visiting the dashboard needs these
AUTH_USER=alph4
AUTH_PASS=change-me-to-something-strong

# WooCommerce REST API credentials (WP admin → WooCommerce → Settings → Advanced → REST API)
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# How often to regenerate the dashboard from live WC data (seconds)
CACHE_SECONDS=60

# PORT is auto-set by Railway/Render. Only set locally.
# PORT=3000
